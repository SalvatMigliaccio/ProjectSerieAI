{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Naples — track record API",
    "description": "\nRead-only view over the Serie A prediction track record.\n\n**The production model is M1**: the bookmaker's opening line with the margin\nremoved. Fair odds and overround are exposed because they are descriptive;\nexpected value, stakes and betting advice are not exposed at all — an EV\ncomputed from M1's probabilities against the very odds they come from is\ncircular by construction, and measured to be negative on every single bet.\n\nWriting happens only from local scheduled commands, never over HTTP.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/season/{season}": {
      "get": {
        "summary": "Season headline figures",
        "operationId": "get_season_api_season__season__get",
        "parameters": [
          {
            "name": "season",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Season"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
