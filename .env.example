# Copia in `.env` e cambia i valori. `.env` NON va versionato: e' la regola
# di sicurezza n.1 — nessun segreto nel repository, nemmeno in un file di
# esempio. Qui ci sono solo segnaposto.
#
#   cp .env.example .env
#   docker compose up -d

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=ainaples
POSTGRES_PASSWORD=cambiami-in-locale
POSTGRES_DB=ainaples
# Se sulla macchina c'e' gia' un altro Postgres, cambia questa e l'URL sotto.
POSTGRES_PORT=5432

# L'URL che usa l'applicazione. Deve combaciare con i valori qui sopra.
# In produzione arriva dall'ambiente del servizio, non da un file.
AI_NAPLES_DATABASE_URL=postgresql+psycopg://ainaples:cambiami-in-locale@127.0.0.1:5432/ainaples

# ---------------------------------------------------------------------------
# Posta
# ---------------------------------------------------------------------------
# In sviluppo punta a Mailpit, che CATTURA tutto e non consegna niente:
# le mail si leggono su http://127.0.0.1:8025
# In produzione qui va un provider vero (SES, Postmark, Resend, un relay
# aziendale): cambiano solo queste variabili, il codice no.
AI_NAPLES_SMTP_HOST=127.0.0.1
AI_NAPLES_SMTP_PORT=1025
AI_NAPLES_SMTP_USER=
AI_NAPLES_SMTP_PASSWORD=
# none | starttls | ssl  — Mailpit accetta `none`; un provider vero vuole
# `starttls` (587) oppure `ssl` (465).
AI_NAPLES_SMTP_SECURITY=none
AI_NAPLES_SMTP_FROM=no-reply@ainaples.local
AI_NAPLES_SMTP_FROM_NAME=AI Naples

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Sessioni
# ---------------------------------------------------------------------------
# Chiave per firmare il cookie di sessione. GENERANE UNA NUOVA:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Cambiarla invalida tutte le sessioni attive, che e' anche il modo di
# buttarle fuori tutte in fretta.
AI_NAPLES_SECRET_KEY=generane-una-con-secrets-token-urlsafe-64

# `1` solo dietro HTTPS: mette `Secure` sul cookie. In locale su http resta 0,
# altrimenti il browser non lo manda indietro e il login sembra rotto.
AI_NAPLES_COOKIE_SECURE=0

# L'indirizzo pubblico del frontend, usato per costruire i link nelle mail
# di verifica e di reset.
AI_NAPLES_PUBLIC_URL=http://127.0.0.1:5173
