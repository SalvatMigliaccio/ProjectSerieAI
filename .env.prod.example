# Production values. Copy to `.env` ON THE SERVER and fill it in; never commit
# the filled version — security rule 1.
#
#   docker compose -f compose.prod.yaml up -d --build
#   docker compose -f compose.prod.yaml exec api alembic -c alembic.ini upgrade head
#   docker compose -f compose.prod.yaml exec api python -m backend.auth.cli check-config

# The hostname Caddy requests a certificate for. Must already point at this
# server, or the certificate request fails and nothing is served over HTTPS.
DOMAIN=matchpoint.example.com
AI_NAPLES_PUBLIC_URL=https://matchpoint.example.com

POSTGRES_USER=ainaples
POSTGRES_PASSWORD=
POSTGRES_DB=ainaples

# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it invalidates every outstanding verification and reset link.
AI_NAPLES_SECRET_KEY=

# A real provider. Mailpit catches mail and delivers none of it, which in
# production means every signup silently fails to arrive.
AI_NAPLES_SMTP_HOST=smtp.provider.example
AI_NAPLES_SMTP_PORT=587
AI_NAPLES_SMTP_USER=
AI_NAPLES_SMTP_PASSWORD=
AI_NAPLES_SMTP_SECURITY=starttls
AI_NAPLES_SMTP_FROM=no-reply@matchpoint.example.com

# Where the pipeline writes on the host. The API mounts both read-only.
TRACK_RECORD_DIR=./track_record
DATA_DIR=./data
