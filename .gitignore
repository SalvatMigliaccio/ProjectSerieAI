data/
__pycache__/
*.pyc
.venv/
manual/team_name_map_suggested.json

# Il registro delle previsioni E' versionato: e' l'unico dato del progetto
# che non si puo' rigenerare. Si escludono le copie di lavoro e le
# ricostruzioni, che invece si rifanno quando servono.
track_record/*.bak
track_record/predictions_backfill.csv
# Il report e' una vista del registro: si rigenera con 'python -m src.report',
# e versionarne una copia nuova ogni settimana sarebbe solo rumore nel diff.
track_record/report.html

# Esperimenti: le previsioni grezze del walk-forward si rigenerano e pesano,
# quindi restano fuori. Si versionano solo i riassunti — il numero che si e'
# misurato e con quale codice — perche' sono quelli che servono a distanza di
# mesi per capire perche' un set e' stato scartato o tenuto.
experiments/output/*
!experiments/output/riassunto_*.csv
!experiments/output/riassunto_*.md

# Artefatti di build e di packaging: si rigenerano con `pip install -e .`
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Log dello scheduler: si rigenerano a ogni esecuzione e crescono di un file
# al giorno. `last_run.json` e' lo stato che legge /api/status, ed e' anch'esso
# locale: in un clone nuovo "nessuna esecuzione registrata" e' la verita'.
logs/

# web/openapi.json INVECE e' versionato: e' il contratto passato al frontend,
# e un contratto che vive solo in un processo non si puo' rivedere in un diff.

# Frontend: dipendenze e build si rigenerano da package-lock.json.
# `.env.local` contiene l'URL del tunnel, che e' effimero e personale: fuori.
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env

# Artefatti di seleniumbase: lock e download temporanei dello scraper
# WhoScored. Si rigenerano a ogni avvio del browser.
downloaded_files/

# I segreti veri: fuori dal repository (regola di sicurezza n.1).
.env
