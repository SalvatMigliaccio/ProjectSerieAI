# Copia questo file in `.env.local` e modifica i valori.
#
# VITE_API_BASE_URL e' l'URL dell'API in sola lettura. In sviluppo e' il
# server locale; per far lavorare il frontend contro la macchina che predice,
# ci va l'URL del tunnel (ngrok), che cambia a ogni riavvio nel piano gratuito
# — per questo sta in una variabile d'ambiente e non nel codice.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Stagione da mostrare. L'API accetta sia "2627" sia "2026-27".
VITE_SEASON=2627
